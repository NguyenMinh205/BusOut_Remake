    loadingDescription: Tapped the wrong car? Undo sends it back to its parking spot
      before anyone boards.
  - type: 3
    displayName: HELICOPTER
    icon: {fileID: 21300000, guid: 735cb22d27028de449b12119df0dea34, type: 3}
