# ===================================================
# .gitignore chuẩn thực tế cho Unity + Visual Studio + Windows
# Tham khảo: github/gitignore (Unity), Microsoft, Unity Docs
# ===================================================

# ==============================
# UNITY GENERATED (Bắt buộc ignore)
# ==============================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/
.utmp/
sysinfo.txt

# ==============================
# UNITY META FILES (Chỉ ignore meta của file tự gen, KHÔNG ignore meta của Assets)
# ==============================
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ==============================
# UNITY BUILD OUTPUT
# ==============================
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# ==============================
# UNITY ADDRESSABLES
# ==============================
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ==============================
# VISUAL STUDIO
# ==============================
.vs/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.unityproj
ExportedObj/

# Các file debug/compile VS tự tạo
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp

# ==============================
# LOG FILES
# ==============================
*.log

# ==============================
# WINDOWS
# ==============================
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# ==============================
# FIREBASE / CRASHLYTICS
# ==============================
crashlytics-build.properties
crashlytics.properties
com_crashlytics_export_strings.xml
fabric.properties
google-services.json

# ==============================
# SECRETS & SENSITIVE (Bảo mật)
# ==============================
# Không commit API key, secret key, keystore lên Git!
*.keystore
*.jks
local.properties

# ==============================
# LOCAL DOCS (Local only, không commit)
# ==============================
/docs/

# ==============================
# OS / EDITOR KHÁC
# ==============================
.DS_Store         # macOS (nếu dùng cả mac trong team)
.consulo/
.gradle/